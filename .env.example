# Copie este arquivo para .env.local (uso local) e cadastre os mesmos
# valores em Vercel > Project Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# Gere uma string aleatória longa, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cole_aqui_uma_string_aleatoria_longa

# Upstash > Console > Redis > seu database > REST API
UPSTASH_REDIS_REST_URL=https://SEU-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=cole_aqui_o_token_rest

NODE_ENV=production
